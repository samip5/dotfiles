{{- /* Checks if running interactively */ -}}
{{- $interactive := stdinIsATTY -}}

{{- /* Template file for chezmoi config file */ -}}
{{- $profile := "server" -}}{{/* "personal" | "association" | "server" */}}
{{- $kubernetes := false -}}{{/* true if this machine is used for Kubernetes work */}}
{{- $i3wm := false -}}{{/* true if this machine is using i3wm */}}
{{- $swaywm := false -}}{{/* true if this machine is using swaywm */}}
{{- $hyprlandwm := false -}}{{/* true if this machine is using hyprlandwm */}}
{{- $agekey := false -}}{{/* true if this machine has agekey to decrypt secret */}}

{{- $hostname := "" -}}
{{- if (eq .chezmoi.os "darwin") -}}
  {{- $hostname = output "scutil" "--get" "LocalHostName"| trim -}}
{{- else -}}
  {{- $hostname = .chezmoi.hostname -}}
{{- end -}}

{{- $hostname := .chezmoi.hostname -}}
{{- if eq $hostname "Ryzen-Gaming-Gentoo" -}}
{{-   $profile = "personal" -}}
{{-   $kubernetes = true -}}
{{-   $i3wm = false -}}
{{-   $swaywm = false -}}
{{-   $hyprlandwm = false -}}
{{-   $agekey = true -}}
{{- end -}}
{{- if eq $hostname "Orion" -}}
{{-   $profile = "personal" -}}
{{-   $kubernetes = true -}}
{{-   $i3wm = false -}}
{{-   $swaywm = false -}}
{{-   $hyprlandwm = false -}}
{{-   $agekey = true -}}
{{- end -}}
{{- if eq $hostname "Aurora" -}}
{{-   $profile = "personal" -}}
{{-   $kubernetes = true -}}
{{-   $i3wm = false -}}
{{-   $swaywm = true -}}
{{-   $hyprlandwm = true -}}
{{-   $agekey = true -}}
{{- end -}}
{{- if hasKey . "profile" -}}
{{-   $profile = .profile -}}
{{- else if $interactive -}}
{{-   $profile = promptString "profile (personal/association/server)" -}}
{{- end -}}
{{- if hasKey . "kubernetes" -}}
{{-   $kubernetes = .kubernetes -}}
{{- else if $interactive -}}
{{-   $kubernetes = promptBool "kubernetes" -}}
{{- end -}}
{{- if hasKey . "agekey" -}}
{{-   $agekey = .agekey -}}
{{- else if $interactive -}}
{{-   $agekey = promptBool "agekey" -}}
{{- end -}}

{{- /* Git identity — prompted once, stored in chezmoi config */ -}}
{{- $gitEmail := "" -}}
{{- $gitName := "" -}}
{{- if hasKey . "gitEmail" -}}
{{-   $gitEmail = .gitEmail -}}
{{- else if $interactive -}}
{{-   $gitEmail = promptString "git email" -}}
{{- end -}}
{{- if hasKey . "gitName" -}}
{{-   $gitName = .gitName -}}
{{- else if $interactive -}}
{{-   $gitName = promptString "git name" -}}
{{- end -}}

{{- if $interactive -}}
{{-   writeToStdout "💡 Tip: you can re-enter your data with `chezmoi init --data=false`.\n" -}}
{{- end -}}

data:
  profile: {{ $profile }}
  kubernetes: {{ $kubernetes }}
  i3wm: {{ $i3wm }}
  swaywm: {{ $swaywm }}
  hyprlandwm: {{ $hyprlandwm }}
  agekey: {{ $agekey }}
  gitEmail: {{ $gitEmail }}
  gitName: {{ $gitName }}
format: yaml
encryption: age
{{- if $agekey }}
age:
  identity: {{ .chezmoi.homeDir }}/.config/sops/age/keys.txt
  recipient: age1kyu4t3wc94687gy4pw58jdnftckwh2ewpnqrqd2jvu9wvwa3sf3qywmgap
{{- end }}
git:
  autoAdd: true
